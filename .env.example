OPENAI_API_KEY=
SUPADATA_API_KEY=

# Neon connection string — https://console.neon.tech
DATABASE_URL=

# Signs the device cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Stripe — test keys for development, live keys only in the deploy environment
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally;
# from the dashboard destination in production. They are different values.
STRIPE_WEBHOOK_SECRET=
